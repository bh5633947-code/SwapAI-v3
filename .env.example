# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NUNCA coloque esta chave em variáveis NEXT_PUBLIC_*. Ela ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Anti-abuso ----
# Segredo do HMAC de identidades (e-mail, telefone, IP). Gere com: openssl rand -hex 32
# Trocar este valor invalida os fingerprints antigos. Não troque depois de lançar.
IDENTITY_HMAC_SECRET=

# Cloudflare Turnstile. A secret key fica no Supabase: Authentication > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis (rate limit). Obrigatório em produção (fail-closed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Regras de negócio ----
FREE_SIGNUP_CREDITS=1
MAX_SIGNUPS_PER_IP_PER_DAY=2
MAX_JOBS_PER_USER_PER_DAY=10
MAX_GLOBAL_JOBS_PER_DAY=500
# true = exige verificação de telefone (SMS) para ganhar o crédito grátis. Recomendado em produção.
REQUIRE_PHONE_VERIFICATION=false

# ---- Mercado Pago (use credenciais de TESTE primeiro) ----
# Suas integrações > Credenciais > Access token
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Suas integrações > Webhooks > Assinatura secreta (chave do modo do webhook: teste ou produção)
MP_WEBHOOK_SECRET=
# URL pública do app, sem barra final. Usada nas URLs de retorno e no webhook.
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# ---- Alibaba Cloud Model Studio (DashScope) ----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
WORKSPACE_ID=your-workspace-id
SWAP_MODE=wan-std
# DASHSCOPE_BASE_URL=https://seu-endpoint-confirmado-no-console

# ---- Vercel Blob (preenchida ao conectar o Blob Store no projeto) ----
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
